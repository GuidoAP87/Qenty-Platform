# Base de datos. Vacio = SQLite local (instance/qenty.db).
# En produccion, la URL de Postgres que te da el hosting.
DATABASE_URL=

# Clave de sesion de Flask. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciales del administrador. Se aplican al arrancar la app.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador Qenty

# Access Token de Mercado Pago (produccion o de prueba)
MP_ACCESS_TOKEN=
